APP_NAME="Hospital HIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Para MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hospital_his
# DB_USERNAME=root
# DB_PASSWORD=

# --- Arquitectura federada CENTRAL/HOSPITAL (docs/modulos/mod03/ADR-001-arquitectura.md) ---
# La conexión "default" de arriba es la base HOSPITAL de esta sucursal (datos clínicos/locales,
# aislados además por columna tenant_id). CENTRAL_DB_* configura la base CENTRAL de red
# (tenants, mpi_patients, patient_hospital_links, identity_match_candidates), que debe ser una
# base PostgreSQL físicamente distinta en cualquier entorno real. Si se deja sin definir, cae al
# mismo SQLite que la conexión por defecto (solo para desarrollo rápido).
# Ejemplo apuntando al PostgreSQL local para el módulo 03:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=shi_hospital_glendi
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
#
# CENTRAL_DB_CONNECTION=pgsql
# CENTRAL_DB_HOST=127.0.0.1
# CENTRAL_DB_PORT=5432
# CENTRAL_DB_DATABASE=shi_central_glendi
# CENTRAL_DB_USERNAME=postgres
# CENTRAL_DB_PASSWORD=postgres

# Umbrales de la política de emparejamiento MPI (dominio, ver PatientMatchingPolicy)
PATIENTS_MPI_AUTO_LINK_THRESHOLD=0.92
PATIENTS_MPI_REVIEW_THRESHOLD=0.60

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# URL absoluta del API si el frontend Vite corre en otro origen (desarrollo típico):
VITE_API_URL=http://localhost:8000/api/v1
